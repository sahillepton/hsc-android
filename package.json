{
  "name": "hsc-windows-android",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "generate:places": "node tools/generate-places.cjs",
    "convert:xlsx": "node tools/convert-xlsx-to-json.cjs",
    "electron:dev": "concurrently \"vite --force --config vite.config.electron.ts\" \"node scripts/wait-and-electron.js\"",
    "electron:build": "vite build --config vite.config.electron.ts",
    "build:electron": "node scripts/build-electron.js",
    "electron": "yarn build:electron && electron .",
    "prepackage": "node scripts/fetch-gdal-electron-prebuild.mjs",
    "package": "yarn prepackage && yarn electron:build && yarn build:electron && electron-builder",
    "sync:mcsa-gis-android-sync": "node scripts/sync-integration-assets.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/app": "^7.1.0",
    "@capacitor/cli": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@capacitor/filesystem": "^7.1.5",
    "@capacitor/geolocation": "5.0.8",
    "@capacitor/preferences": "^7.0.2",
    "@capacitor/share": "^7.0.2",
    "@deck.gl/geo-layers": "^9.2.2",
    "@electron/rebuild": "^4.0.4",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.1.12",
    "@turf/turf": "^7.2.0",
    "@types/papaparse": "^5.3.16",
    "@types/shpjs": "^3.4.7",
    "capacitor-file-picker": "^1.0.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "deck.gl": "^9.2.2",
    "gdal-async": "^3.12.3",
    "geotiff": "^2.1.4-beta.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.542.0",
    "mapbox-gl": "^3.14.0",
    "milsymbol": "^3.0.3",
    "papaparse": "^5.5.3",
    "proj4": "^2.19.10",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-map-gl": "^8.0.4",
    "react-virtuoso": "^4.17.0",
    "react-window": "^2.2.3",
    "sharp": "^0.34.5",
    "shpjs": "^6.1.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.12",
    "ws": "^8.18.0",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.0",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "tw-animate-css": "^1.3.8",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.1.2"
  },
  "build": {
    "appId": "com.hsc.desktop",
    "productName": "GIS",
    "directories": {
      "output": "release"
    },
    "npmRebuild": false,
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "asarUnpack": [
      "node_modules/**/*",
      "dist-electron/tiling/worker.cjs"
    ],
    "extraResources": [
      {
        "from": "dist-electron/tiling/worker.cjs",
        "to": "tiling/worker.cjs"
      },
      {
        "from": "bundled-runtime/node.exe",
        "to": "node.exe"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/vite.svg",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
